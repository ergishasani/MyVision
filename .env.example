# ==============================================================================
# MyVision — environment template
#
# Copy to `.env` and fill in.  `.env` is gitignored; never commit real values.
# Every value shown is the default the app falls back to when the variable is
# unset, so anything you do not set still boots.
#
# Legend:
#   [REQUIRED]  must be set before production
#   [SECRET]    never expose to the browser, never commit
#   [PUBLIC]    NEXT_PUBLIC_* is compiled into the browser bundle — public by
#               design, so put nothing sensitive here
# ==============================================================================


# ------------------------------------------------------------------------------
# Database — PostgreSQL
# ------------------------------------------------------------------------------
# Defaults match the `postgres` service in docker-compose.yml. Any PostgreSQL 16
# instance works; Flyway migrates the schema automatically on start.
DATABASE_URL=jdbc:postgresql://localhost:5432/myvision
DATABASE_USERNAME=myvision
DATABASE_PASSWORD=myvision            # [REQUIRED] [SECRET] in production


# ------------------------------------------------------------------------------
# Application secret — generate this yourself
# ------------------------------------------------------------------------------
# [REQUIRED] [SECRET] Signs every JWT. Anyone holding it can mint a valid token
# for any user, so treat it like a database password. Use at least 32 random
# bytes; rotating it signs everyone out.
#
#   openssl rand -base64 48
#
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000            # access token lifetime (24h)


# ==============================================================================
# THIRD-PARTY API KEYS
# ==============================================================================

# ------------------------------------------------------------------------------
# Stripe — card payments        https://dashboard.stripe.com/apikeys
# ------------------------------------------------------------------------------
# Leave STRIPE_SECRET_KEY empty and payments stay disabled: the rest of the API
# is unaffected and /api/invoices/{id}/checkout-session answers 503.
#
# STRIPE_WEBHOOK_SECRET is what lets Stripe report a successful payment. Without
# it invoices NEVER move to paid, because an unverified webhook is rejected.
# Get it from the dashboard endpoint, or from `stripe listen --forward-to`:
#
#   stripe listen --forward-to localhost:8080/api/stripe/webhook
#
# See docs/stripe-setup.md.
STRIPE_SECRET_KEY=                    # [SECRET] sk_test_... / sk_live_...
STRIPE_PUBLISHABLE_KEY=               # pk_test_... / pk_live_... (safe to expose)
STRIPE_WEBHOOK_SECRET=                # [SECRET] whsec_...
STRIPE_SUCCESS_URL=http://localhost:3000/invoices?payment=success
STRIPE_CANCEL_URL=http://localhost:3000/invoices?payment=cancelled

# ------------------------------------------------------------------------------
# Resend — transactional email  https://resend.com/api-keys
# ------------------------------------------------------------------------------
# MAIL_PROVIDER=log writes emails to the application log instead of sending, which
# is the default for local development. Set it to `resend` for real delivery.
# The sending domain must be verified in Resend or mail lands in spam.
MAIL_PROVIDER=log                     # log | resend
MAIL_FROM=MyVision <no-reply@myvision.visionbau.de>
RESEND_API_KEY=                       # [SECRET] re_...
RESEND_ENDPOINT=https://api.resend.com/emails

# ------------------------------------------------------------------------------
# Google Sign-In    https://console.cloud.google.com/apis/credentials
# ------------------------------------------------------------------------------
# Create an OAuth 2.0 Client ID of type "Web application". The backend verifies
# incoming Google ID tokens against this list, so it must contain the same client
# id the frontend uses. Comma-separated to allow several (web, iOS, Android).
# There is no client *secret* here: the flow is ID-token verification, not the
# authorization-code exchange.
AUTH_GOOGLE_CLIENT_IDS=               # your-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Apple Sign-In     https://developer.apple.com/account/resources/identifiers
# ------------------------------------------------------------------------------
# This is the Services ID (not the App ID, not the Team ID). The backend verifies
# Apple identity tokens against Apple's public keys and checks this audience.
AUTH_APPLE_CLIENT_ID=                 # com.yourcompany.myvision.web


# ==============================================================================
# BACKEND CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & CORS
# ------------------------------------------------------------------------------
SERVER_PORT=8080
AUTH_FRONTEND_BASE_URL=http://localhost:3000    # used to build links in emails
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# Auth token lifetimes & rate limiting
# ------------------------------------------------------------------------------
AUTH_REFRESH_TOKEN_EXPIRATION_MS=2592000000     # 30 days
AUTH_PASSWORD_RESET_EXPIRATION_MS=3600000       # 1 hour
AUTH_EMAIL_VERIFICATION_EXPIRATION_MS=86400000  # 24 hours

# DANGER: returns reset/verification tokens in API responses so you can test
# without email delivery configured. NEVER enable in production.
AUTH_RETURN_SENSITIVE_TOKENS=false

AUTH_RATE_LIMIT_MAX_ATTEMPTS=5        # per email+IP, on login/register/reset
AUTH_RATE_LIMIT_WINDOW_MS=900000      # 15 minutes
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_MAX_REQUESTS=120       # general API limit, per window
APP_RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# File storage
# ------------------------------------------------------------------------------
# Invoice PDFs and XRechnung XML are written to the filesystem. In a container
# STORAGE_LOCAL_ROOT must be a MOUNTED VOLUME, or every generated document is
# lost on restart. Only logos are served publicly, from STORAGE_PUBLIC_BASE_URL.
STORAGE_LOCAL_ROOT=.myvision-storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/files

# ------------------------------------------------------------------------------
# API documentation (Swagger)
# ------------------------------------------------------------------------------
# Set all three to false in production. The schema also requires authentication
# by design, which AuthIntegrationTest.docsRequireAuthentication enforces.
SPRINGDOC_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
SPRINGDOC_API_DOCS_ENABLED=true

# ------------------------------------------------------------------------------
# Background sweeps
# ------------------------------------------------------------------------------
# Overdue sweep moves sent / partially-paid invoices past their due date to
# `overdue`. Token cleanup deletes expired auth tokens after the retention
# window. Both are idempotent. APP_SCHEDULING_ENABLED=false stops both without
# a redeploy.
APP_SCHEDULING_ENABLED=true
INVOICES_OVERDUE_SWEEP_CRON=0 10 2 * * *
AUTH_TOKEN_CLEANUP_CRON=0 30 3 * * *
AUTH_TOKEN_CLEANUP_RETENTION_DAYS=7

# ------------------------------------------------------------------------------
# Invoice compliance
# ------------------------------------------------------------------------------
# Germany-first defaults. Review country rules with a qualified tax adviser
# before onboarding customers outside a test environment — see
# docs/invoice-compliance-checklist.md.
COMPLIANCE_INVOICE_COUNTRY=DE
COMPLIANCE_XRECHNUNG_ENABLED=true


# ==============================================================================
# FRONTEND  (Next.js)
#
# NEXT_PUBLIC_* is [PUBLIC]: inlined into the browser bundle and readable by
# anyone. Never put a secret here. Duplicate these into frontend/.env.local for
# local development.
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Must match the backend values above, or sign-in fails audience validation.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=         # same as AUTH_GOOGLE_CLIENT_IDS entry
NEXT_PUBLIC_APPLE_CLIENT_ID=          # same as AUTH_APPLE_CLIENT_ID

# Optional: image shown beside the login/register form. Add the file under
# frontend/public/ first, then set the path.
# NEXT_PUBLIC_AUTH_PREVIEW_IMAGE=/images/auth-dashboard-preview.png
