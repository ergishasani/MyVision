DATABASE_URL=jdbc:postgresql://localhost:5432/myvision
DATABASE_USERNAME=myvision
DATABASE_PASSWORD=myvision
JWT_SECRET=replace-with-a-long-random-secret
AUTH_REFRESH_TOKEN_EXPIRATION_MS=2592000000
AUTH_PASSWORD_RESET_EXPIRATION_MS=3600000
AUTH_EMAIL_VERIFICATION_EXPIRATION_MS=86400000
AUTH_RETURN_SENSITIVE_TOKENS=false
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_MAX_REQUESTS=120
APP_RATE_LIMIT_WINDOW_MS=60000
AUTH_FRONTEND_BASE_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SPRINGDOC_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
SPRINGDOC_API_DOCS_ENABLED=true
MAIL_PROVIDER=log
MAIL_FROM=MyVision <no-reply@myvision.visionbau.de>
RESEND_API_KEY=
STORAGE_LOCAL_ROOT=.myvision-storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/files
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# --- Stripe -------------------------------------------------------------------
# Leave STRIPE_SECRET_KEY empty and payment links stay disabled; the rest of the
# API is unaffected and /api/invoices/{id}/checkout-session answers 503.
# Test keys start sk_test_ / whsec_. Get the webhook secret from either the
# Stripe dashboard endpoint or `stripe listen --forward-to`.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/invoices?payment=success
STRIPE_CANCEL_URL=http://localhost:3000/invoices?payment=cancelled

# --- Background sweeps ---------------------------------------------------------
# Overdue sweep moves sent/partially-paid invoices past their due date to overdue.
# Token cleanup deletes expired auth tokens after the retention window.
# Set APP_SCHEDULING_ENABLED=false to stop both without redeploying.
APP_SCHEDULING_ENABLED=true
INVOICES_OVERDUE_SWEEP_CRON=0 10 2 * * *
AUTH_TOKEN_CLEANUP_CRON=0 30 3 * * *
AUTH_TOKEN_CLEANUP_RETENTION_DAYS=7
