# Frontend-only environment. Copy to .env.local (gitignored).
#
# NEXT_PUBLIC_* is compiled into the browser bundle and readable by anyone.
# Never put a secret here. The full project template is ../.env.example.

NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Social sign-in. Must match the backend's AUTH_GOOGLE_CLIENT_IDS /
# AUTH_APPLE_CLIENT_ID, or sign-in fails audience validation.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_APPLE_CLIENT_ID=your.apple.service.id

# Optional: image beside the login/register form. Add the file under public/ first.
# NEXT_PUBLIC_AUTH_PREVIEW_IMAGE=/images/auth-dashboard-preview.png
